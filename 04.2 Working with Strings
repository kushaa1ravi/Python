phrase = "Blah Blah"
print(phrase)                           # Prints Blah Blah

print(phrase[0])                        # Prints B
print(phrase[1])                        # Prints l
print(phrase[2])                        # Prints a
print(phrase[3])                        # Prints h
print(phrase[4])                        # Prints (space)
print(phrase[5])                        # Prints B
print(phrase[6])                        # Prints l
print(phrase[7])                        # Prints a
print(phrase[8])                        # Prints h

print(phrase.index("a"))                # Tells us where a character is located = Index 2

print(phrase.count("ah"))               # Counts occurrences of "ah"

try:
    print(phrase.index("z"))            # Will show an error because z is absent
except ValueError:
    print("'z' not found in phrase")

print(phrase.replace("Blah", "Hehe"))   # Replaces "Blah" with "Hehe"
