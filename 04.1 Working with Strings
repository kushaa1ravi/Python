phrase = "Blah Blah"               # Initialize string variable with "Blah Blah"

print(phrase)                      # Print the original phrase

print(phrase+" is Blah")           # Print the phrase with additional text concatenated

print(phrase.lower())              # Print the phrase converted to lowercase

print(phrase.upper())              # Print the phrase converted to uppercase

print(phrase.capitalize())         # Print the phrase with only first character capitalized

print(phrase.title())              # Print the phrase with title case (first letter of each word capitalized)

print(phrase.isupper())            # Check and print if the entire phrase is uppercase (returns boolean)

print(phrase.islower())            # Check and print if the entire phrase is lowercase (returns boolean)

print(phrase.istitle())            # Check and print if the phrase is in title case (returns boolean)

print(phrase.upper().isupper())    # Convert to uppercase and check if it's uppercase (returns True)

print(len(phrase))                 # Print the length/number of characters in the phrase
