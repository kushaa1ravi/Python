phrase = "Blah Blah"

print(phrase)                      # Phrase                                                    # Blah Blah

print(phrase+" is Blah")           # Pharse is Blah                                            # Blah Blah is Blah

print(phrase.lower())              # Print it in lower case                                    # blah blah

print(phrase.upper())              # Print it in upper case                                    # BLAH BLAH

print(phrase.capitalize())         # Capitalises only the first letter of the first word       # Blah blah

print(phrase.title())              # Capatilises first letter of all words in the phrase       # Blah Blah

print(phrase.isupper())            # Checks if phrase is in upper case                         # False

print(phrase.islower())            # Checks if phrase is in lower case                         # False

print(phrase.istitle())            # Checks if case is in title case                           # True

print(phrase.upper().isupper())    # Converts pharse into upper case and checks if it's true   # True

print(len(phrase))                 # Checks the length of the phrase                           # 9
